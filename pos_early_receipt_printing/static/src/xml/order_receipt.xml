<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_early_receipt_printing.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="after">
            <div
                t-if="!order.finalized and !order.config.module_pos_restaurant and order.tracking_number"
                class="tracking-number fs-1 text-center"
                t-esc="order.tracking_number"
            />
        </xpath>
    </t>
</templates>
