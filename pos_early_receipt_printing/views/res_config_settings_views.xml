<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_early_receipt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.early.receipt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_bills_and_receipts_section" position="inside">
                <setting
                    id="iface_printbill_non_restaurant"
                    string="Early Receipt Printing"
                    help="Allow printing a bill before payment"
                    invisible="pos_module_pos_restaurant or is_kiosk_mode"
                >
                    <field name="pos_iface_printbill"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
