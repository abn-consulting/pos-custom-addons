<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_early_receipt_printing.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath
            expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]"
            position="before">
            <button
                t-if="!pos.config.module_pos_restaurant and pos.config.iface_printbill"
                t-att-class="buttonClass"
                t-att-disabled="!pos.getOrder()?.getOrderlines()?.length"
                t-on-click="clickPrintBill">
                <i class="fa fa-print me-1"/>
                Bill
            </button>
        </xpath>
    </t>
</templates>
