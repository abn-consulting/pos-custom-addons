<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sensible_restaurant_access_rights_employee.ActionpadWidget"
       t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">

        <!-- Original pay-order-button (inside validation div): use JS getter for visibility -->
        <xpath expr="//div[hasclass('validation')]//button[hasclass('pay-order-button')]" position="attributes">
            <attribute name="t-if">sblShowOriginalPayButton</attribute>
        </xpath>

        <!-- Restaurant's Payment button (has pay-order-button-restaurant class): use JS getter for visibility -->
        <xpath expr="//button[hasclass('pay-order-button-restaurant')]" position="attributes">
            <attribute name="t-if">sblShowRestaurantPayButton</attribute>
        </xpath>

        <!-- Hide Order/Submit button based on employee setting -->
        <xpath expr="//button[hasclass('submit-order')]" position="attributes">
            <attribute name="t-if">!this.currentOrder.isDirectSale and this.displayCategoryCount.length and !sblHideOrderButton</attribute>
        </xpath>

    </t>
</templates>
